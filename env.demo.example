# Variables para un despliegue o build de DEMOSTRACIÓN.
# No son secretos. No copiar valores de producción.
# La URL de Postgres es falsa: solo existe para que `prisma generate` pueda ejecutarse.
# Con isolated-demo la aplicación bloquea /api y no abre esa conexión.
#
# Uso local del build aislado:
#   cp env.demo.example .env.local

NEXT_PUBLIC_DEPLOYMENT_MODE=isolated-demo
QXFLOW_ISOLATED_DEMO=true
DATABASE_URL=postgresql://demo:demo@127.0.0.1:5432/qxflow_demo_unused
DIRECT_URL=postgresql://demo:demo@127.0.0.1:5432/qxflow_demo_unused
