// Prisma schema - Bloque Quirúrgico Covadonga
// PostgreSQL para producción y desarrollo piloto.
// Para desarrollo local sin Postgres: use DATABASE_URL de Neon/Supabase (gratis).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  GESTOR
  ANESTESISTA
  CIRUJANO
  ENDOSCOPISTA
  GESTOR_ANESTESISTA
  GESTION_CITAS
}

enum Shift {
  MORNING
  AFTERNOON
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  CANCELLED
}

model User {
  id                       String                      @id @default(cuid())
  email                    String                      @unique
  passwordHash             String
  name                     String
  role                     UserRole
  approved                 Boolean                     @default(false)
  canSespa                 Boolean                     @default(false)
  deletedAt                DateTime?
  deletedByUserId          String?
  deletionReason           String?                     @db.Text
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  reservations             Reservation[]               @relation("SurgeonReservations")
  anesthetistAssignments   AnesthetistAssignment[]
  anesthetistProfile       AnesthetistProfile?
  surgeonDefault           SurgeonDefault?
  anesthetistUnavailability AnesthetistUnavailability[]
  blockOpeningPlansApproved BlockOpeningPlan[]
  blockSlotPlansApproved   BlockSlotOpeningPlan[]
}

enum ReservationOrigin {
  APP
  EMAIL
  GESTOR
}

model Reservation {
  id                 String              @id @default(cuid())
  date               DateTime
  resourceId         String
  shift              Shift
  slotIndex          Int
  surgeonId          String
  status             ReservationStatus  @default(PENDING)
  anesthetistId      String?
  origin             ReservationOrigin   @default(APP)
  createdByUserId    String?
  updatedByUserId    String?
  releasedAt         DateTime?
  cancelledAt        DateTime?
  releaseReason      String?
  cancellationReason String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  surgeon           User               @relation("SurgeonReservations", fields: [surgeonId], references: [id])
  patients          PatientInBlock[]
  events            ReservationEvent[]

  @@unique([date, resourceId, shift, slotIndex])
}

enum ReservationEventType {
  RESERVATION_CREATED
  RESERVATION_CREATED_FROM_EMAIL
  RESERVATION_UPDATED
  RESERVATION_CANCELLED
  RESERVATION_RELEASED
  AUTO_RELEASE_TO_COMMON_POOL
  RESERVATION_REJECTED_CONFLICT
  RESERVATION_PATIENT_UPDATED
  RESERVATION_PATIENT_REPLACED
  RESERVATION_PATIENT_CANCELLED
  PATIENT_WORKFLOW_STARTED
  PREANESTHESIA_PENDING
  PATIENT_NOTIFICATION_DRY_RUN_CREATED
  ADMIN_NOTIFICATION_DRY_RUN_CREATED
  ADMIN_NOTIFICATION_SKIPPED_NO_EMAIL
  PATIENT_SURGICAL_CIRCUIT_SUSPENDED
  PREANESTHESIA_APPOINTMENT_ASSIGNED
  DEFERRED_URGENCY_CREATED
  PREANESTHESIA_NO_SLOT_AVAILABLE
}

model ReservationEvent {
  id            String              @id @default(cuid())
  reservationId String?
  eventType     ReservationEventType
  actorUserId   String?
  origin        String?
  detailsJson   String?
  createdAt     DateTime            @default(now())

  reservation   Reservation?        @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([reservationId])
  @@index([eventType])
  @@index([createdAt])
}

enum AssignmentType {
  OR
  PREANESTHESIA
}

model AnesthetistAssignment {
  id              String         @id @default(cuid())
  date            String
  shift           Shift
  assignmentType  AssignmentType @default(OR)
  resourceId      String
  anesthetistId   String

  anesthetist     User           @relation(fields: [anesthetistId], references: [id], onDelete: Cascade)

  @@unique([date, shift, assignmentType, resourceId])
  @@index([anesthetistId])
  @@index([date])
}

/** Cupo de quirófanos simultáneos. Si no hay fila, manda el catálogo de datos o el defecto 2. */
model AnesthetistProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  maxSimultaneousOr Int      @default(2)
  updatedAt         DateTime @updatedAt
  updatedByUserId   String?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** Turno y quirófano habitual. Es una sugerencia: no crea reservas. */
model SurgeonDefault {
  id                   String   @id @default(cuid())
  userId               String   @unique
  defaultShift         Shift?
  preferredResourceId  String?
  active               Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  updatedByUserId      String?

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/** No disponibilidad compartida del anestesista. Sustituye localStorage en modo real. */
model AnesthetistUnavailability {
  id            String   @id @default(cuid())
  anesthetistId String
  date          String   // YYYY-MM-DD
  shift         Shift
  reason        String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  anesthetist   User     @relation(fields: [anesthetistId], references: [id], onDelete: Cascade)

  @@unique([anesthetistId, date, shift])
  @@index([anesthetistId])
  @@index([date])
}

model PatientInBlock {
  id                       String      @id @default(cuid())
  reservationId            String
  historyNumber            String
  fullName                 String?
  procedure                String
  estimatedDurationMinutes Int
  anesthesiaType           String
  insuranceType            String
  admissionType            String?
  orderIndex               Int
  notes                    String?
  solicitudRecursos        String?
  patientEmail             String?
  patientPhone             String?
  workflowStatus           String      @default("ACTIVE")
  preanesthesiaStatus      String      @default("PENDING")
  financingStatus          String      @default("PENDING")
  preanesthesiaAppointmentAt DateTime?
  isDeferredUrgency        Boolean     @default(false)
  specialCircuitReason     String?     @db.Text
  suspensionReason         String?
  suspensionNote           String?     @db.Text

  reservation              Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([preanesthesiaAppointmentAt])
}

enum EmailClassification {
  RESERVATION
  GENERAL
  ACCESS_REQUEST
  UNKNOWN
}

enum EmailProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  SKIPPED
}

enum NotificationOutboxStatus {
  PENDING
  FAILED
  SENT
}

model ProgrammedPatientNotificationOutbox {
  id             String                   @id @default(cuid())
  idempotencyKey String                   @unique
  reservationId  String
  patientId      String
  recipientEmail String
  subject        String
  bodyText       String?                  @db.Text
  status         NotificationOutboxStatus @default(PENDING)
  attemptCount   Int                      @default(0)
  nextAttemptAt  DateTime                 @default(now())
  leaseUntil     DateTime?
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  lastError      String?                  @db.Text
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([status, nextAttemptAt])
  @@index([reservationId])
  @@index([patientId])
}

model EmailMessage {
  id                String              @id @default(cuid())
  externalId        String              @unique
  fromEmail         String
  fromName          String?
  subject           String
  bodyPlain         String?
  bodySummary       String?
  bodyHtml          String?
  receivedAt        DateTime
  classification    EmailClassification @default(UNKNOWN)
  processingStatus  EmailProcessingStatus @default(PENDING)
  resultMessage     String?
  senderUserId      String?
  reservationId     String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  processingLogs    EmailProcessingLog[]
}

model ContactMessage {
  id        String   @id @default(cuid())
  fromName  String
  fromEmail String
  subject   String?
  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ReleaseNotificationLog {
  id                     String   @id @default(cuid())
  releasedCount          Int
  slotDetailsJson        String   @db.Text
  releasedReservationIds String   @db.Text
  recipientCount         Int      @default(0)
  emailStatus            String
  errorMessage           String?  @db.Text
  createdAt              DateTime @default(now())

  @@index([createdAt])
}

model EmailProcessingLog {
  id             String   @id @default(cuid())
  emailMessageId String
  action         String
  details        String?
  errorMessage   String?
  createdAt      DateTime @default(now())

  emailMessage   EmailMessage @relation(fields: [emailMessageId], references: [id], onDelete: Cascade)

  @@index([emailMessageId])
}

enum BlockOpeningStatus {
  OPEN
  CLOSED
  URGENT_RESERVED
}

model BlockOpeningPlan {
  id                    String              @id @default(cuid())
  date                  DateTime
  shift                 Shift
  resourceId            String
  status                BlockOpeningStatus  @default(OPEN)
  minRequiredMinutes    Int                 @default(0)
  reservedUrgentMinutes Int                 @default(0)
  notes                 String?             @db.Text
  approvedByUserId      String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  approvedByUser        User?               @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([date, resourceId, shift])
  @@index([date])
  @@index([resourceId])
}

/** Override exacto de apertura/cierre para un tramo horario; si falta, hereda BlockOpeningPlan del turno. */
model BlockSlotOpeningPlan {
  id               String              @id @default(cuid())
  date             DateTime
  shift            Shift
  resourceId       String
  slotIndex        Int
  status           BlockOpeningStatus  @default(OPEN)
  notes            String?             @db.Text
  approvedByUserId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  approvedByUser   User?               @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@unique([date, resourceId, shift, slotIndex])
  @@index([date])
  @@index([resourceId])
  @@index([status])
}

model ProgrammingRule {
  id              String    @id @default(cuid())
  key             String    @unique
  name            String
  description     String?   @db.Text
  category        String    @default("scheduling")
  valueJson       String?   @db.Text
  isActive        Boolean   @default(true)
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?

  @@index([category])
  @@index([isActive])
}

model UserAuditEvent {
  id          String   @id @default(cuid())
  userId      String
  eventType   String
  actorUserId String?
  detailsJson String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}

/** Equivalente de la hoja 5_CAMBIOS. No borra la fila clínica. */
model ScheduleChange {
  id             String   @id @default(cuid())
  reservationId  String?
  patientId      String?
  changeType     String
  beforeJson     String   @db.Text
  afterJson      String   @db.Text
  reasonCode     String?
  reasonText     String?  @db.Text
  actorUserId    String?
  createdAt      DateTime @default(now())

  @@index([reservationId])
  @@index([patientId])
  @@index([createdAt])
}

model MailTeam {
  id      String           @id @default(cuid())
  name    String
  members MailTeamMember[]
}

model MailTeamMember {
  id     String   @id @default(cuid())
  teamId String
  userId String
  team   MailTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

/** Destinatario de un circuito, por ejemplo el endoscopista de Endoscopias. */
model ServiceRecipient {
  id     String @id @default(cuid())
  key    String @unique
  userId String
}

model OutboundDraft {
  id              String                   @id @default(cuid())
  status          String                   @default("PENDING_APPROVAL")
  subject         String
  bodyText        String                   @db.Text
  reservationId   String?
  proposalId      String?
  warning         String?
  createdByUserId String?
  sentByUserId    String?
  sentAt          DateTime?
  createdAt       DateTime                 @default(now())
  recipients      OutboundDraftRecipient[]

  @@index([status])
  @@index([reservationId])
}

model OutboundDraftRecipient {
  id          String        @id @default(cuid())
  draftId     String
  userId      String?
  email       String
  displayName String
  draft       OutboundDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
}

model Proposal {
  id              String    @id @default(cuid())
  weekStart       String
  type            String
  status          String    @default("PENDING")
  summary         String
  payloadJson     String    @db.Text
  decisionReason  String?   @db.Text
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([status])
  @@index([weekStart])
}

/** Fichero maestro revisable. No es una reserva. */
model IntakeBatch {
  id              String      @id @default(cuid())
  fileName        String
  sheetNames      String
  contentHash     String
  status          String      @default("REVIEW")
  rowCount        Int
  missingKeysJson String?     @db.Text
  createdByUserId String?
  createdAt       DateTime    @default(now())
  rows            IntakeRow[]

  @@index([createdAt])
}

/** Fila de 1_PROGRAMA o DATOS_IQ. El alta a reserva es un paso aparte. */
model IntakeRow {
  id                  String      @id @default(cuid())
  batchId             String
  dedupKey            String
  historyNumber       String
  patientName         String
  procedure           String
  serviceDate         String
  shift               String?
  resourceId          String?
  slotIndex           Int?
  surgeonName         String?
  minutes             Int         @default(60)
  status              String      @default("PENDING")
  flags               String      @default("")
  suggestedShift      String?
  suggestedResourceId String?
  reservationId       String?
  createdAt           DateTime    @default(now())
  batch               IntakeBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([dedupKey])
  @@index([historyNumber])
  @@index([status])
  @@index([serviceDate])
}

/** Nombre aceptado por historia. Un nombre distinto no se fusiona aquí. */
model PatientIdentity {
  id            String   @id @default(cuid())
  historyNumber String   @unique
  displayName   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
