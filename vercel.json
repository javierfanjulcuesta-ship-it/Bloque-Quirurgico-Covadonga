{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install --include=dev --no-audit --no-fund",
  "buildCommand": "NEXT_PUBLIC_DEPLOYMENT_MODE=isolated-demo QXFLOW_ISOLATED_DEMO=true npm run build",
  "env": {
    "NEXT_PUBLIC_DEPLOYMENT_MODE": "isolated-demo",
    "QXFLOW_ISOLATED_DEMO": "true"
  }
}
